# Template de configuração para box PC Ubuntu em fábrica/laboratório.
# Copie para config/config.yaml e ajuste IP do CLP, câmera e GenTL CTI.

config_version: 1
log_level: INFO
log_file: logs/realtec_vision.log
streaming:
  source_type: usb
  video_path: videos/Colchas.mp4
  usb_camera_index: 0
  gentl_cti_path: ''
  gentl_device_index: 0
  gentl_max_dimension: 1920
  gentl_target_fps: 15.0
  unhealthy_restart_after_s: 10.0
detection:
  model_path: model_best
  default_model: model_best
  confidence_threshold: 0.5
  device: auto
  inference_max_consecutive_errors: 5
preprocess:
  roi_enabled: true
cip:
  ip: 192.168.0.10
  port: 44818
  max_retries: 0
  reconnect_backoff_cap_s: 60.0
  auto_reconnect: true
  simulated: false
reliability:
  production_mode: true
  auto_start_operation: true
  plc_sync_on_startup: true
  inhibit_power_management: true
  kiosk_fullscreen: true
  stream_auto_restart: true
  inference_auto_restart: true
output:
  rtsp_enabled: true
  http_port: 8080
  http_path: /stream
