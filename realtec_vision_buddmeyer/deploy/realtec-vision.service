[Unit]
Description=Realtec Vision Buddmeyer — pick-and-place industrial
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%i/realtec_vision_buddmeyer
EnvironmentFile=-%i/realtec_vision_buddmeyer/deploy/realtec-vision.env
ExecStartPre=%i/realtec_vision_buddmeyer/.venv/bin/python %i/realtec_vision_buddmeyer/scripts/preflight_check.py
ExecStart=%i/realtec_vision_buddmeyer/.venv/bin/python %i/realtec_vision_buddmeyer/main.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0
# Display para Qt (ajustar DISPLAY conforme sessão gráfica do operador)
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb

[Install]
WantedBy=multi-user.target
